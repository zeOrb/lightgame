{
  "name": "sunny-tower",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "feedback": "node scripts/feedback-server.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "build:electron": "vite build --configLoader runner && node scripts/build-electron.mjs",
    "locales:compile": "node scripts/compile-locales.mjs",
    "pretest": "npm run locales:compile",
    "locales:update": "node scripts/update-locales.mjs && node scripts/compile-locales.mjs"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1",
    "gettext-parser": "^10.0.0",
    "vite": "^7.2.2"
  }
}
